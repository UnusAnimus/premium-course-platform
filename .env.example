# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
#
# Local development example:
DATABASE_URL="postgresql://courseuser:coursepass@localhost:5432/premium_course_platform?schema=public"
#
# Render / Supabase / Railway — copy the connection string from your dashboard:
# DATABASE_URL="postgresql://..."

# ─── Authentication (future) ──────────────────────────────────────────────────
# NEXTAUTH_SECRET=""
# NEXTAUTH_URL="http://localhost:3000"

# ─── Stripe (future) ─────────────────────────────────────────────────────────
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ─── Mux (future) ────────────────────────────────────────────────────────────
# MUX_TOKEN_ID=""
# MUX_TOKEN_SECRET=""
